{
  "name": "dona-province-dashboard",
  "version": "1.0.0",
  "description": "DONA Province Dashboard — Frontend",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:fe": "turbo run dev --filter=@repo/frontend",
    "dev:be": "cd ../dona-province-dashboard-be && sh ./gradlew bootRun --args='--server.port=8080'",
    "dev:fullstack": "concurrently -n fe,be -c cyan,yellow --kill-others-on-fail \"pnpm dev:fe\" \"pnpm dev:be\"",
    "dev:docs": "turbo run dev:docs",
    "dev:scan": "cross-env VITE_ENABLE_SCAN=true turbo run dev",
    "clean": "turbo run clean && rimraf node_modules .turbo dist",
    "preview": "turbo run preview",
    "build": "turbo run build",
    "lint": "turbo run lint && biome lint .",
    "format": "biome check --write .",
    "openapi": "turbo run openapi",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.13.1",
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "concurrently": "^9.2.1",
    "cpy-cli": "^6.0.0",
    "cross-env": "^7.0.3",
    "husky": "^9.1.7",
    "mkdirp": "^3.0.1",
    "rimraf": "^6.1.2",
    "tsx": "^4.21.0",
    "turbo": "^2.7.3",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@ts-rest/core": "3.53.0-rc.1",
    "date-fns": "^4.1.0"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "^24.10.9",
      "@ts-rest/core": "3.53.0-rc.1",
      "zod": "^4.4.3",
      "date-fns": "^4.2.1",
      "brace-expansion": "^5.0.6"
    }
  }
}
